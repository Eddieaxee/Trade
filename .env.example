# ── Optional data providers ────────────────────────────────────────────────
# The platform works with NO keys: Yahoo Finance supplies real OHLC candles
# (1m…1w) and Frankfurter / ER-API supply fallback reference rates.
# Add a Twelve Data key to enable live bid/ask/spread quotes:
TWELVEDATA_API_KEY=

# ── Optional managed cache (Upstash Redis REST) ────────────────────────────
# When set, analysis snapshots are shared across serverless instances.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Scheduled refresh protection ───────────────────────────────────────────
# /api/cron/refresh requires: Authorization: Bearer <CRON_SECRET> (or ?secret=)
CRON_SECRET=

# ── Cache TTL overrides (seconds) ──────────────────────────────────────────
TTL_CANDLE_INTRADAY=180
TTL_CANDLE_DAILY=3600
TTL_ANALYSIS_INTRADAY=180
TTL_ANALYSIS_DAILY=900
TTL_SNAPSHOT=900
